{
  "name": "medical-workout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Medical Workout: an evidence-linked, local-first personal exercise coach with on-device pose tracking.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "setup:models": "node scripts/setup-models.mjs",
    "verify:models": "node scripts/setup-models.mjs --verify",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "eval:counters": "node scripts/eval-counters.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "onnxruntime-web": "1.30.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.2.4",
    "vitest": "5.0.5"
  }
}
